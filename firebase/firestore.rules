rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function admin() { return signed() && request.auth.token.role == 'admin'; }
    function own() { return signed() && resource.data.uid == request.auth.uid; }
    match /users/{uid} {
      allow read: if signed() && (request.auth.uid == uid || admin());
      allow create: if signed() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['name','photoUrl']);
      allow update: if signed() && request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','photoUrl']);
      allow delete: if false;
    }
    match /{collection}/{id} {
      allow read: if collection in ['recycling_banks','rewards','articles','waste_guides'] && signed() && (resource.data.active == true || admin());
      allow read: if collection in ['waste_scans','waste_deposits','point_transactions','redemptions','carbon_records','notifications'] && (own() || admin());
      allow read: if collection == 'waste_deposits' && signed() && request.auth.token.role == 'staff' && request.auth.uid in get(/databases/$(database)/documents/recycling_banks/$(resource.data.bankId)).data.staffUids;
      allow write: if false;
    }
  }
}
